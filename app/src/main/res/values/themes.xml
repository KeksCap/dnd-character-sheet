<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Основная тема приложения -->
    <style name="Theme.DnDHelper" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Тема для Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Фон заставки (твой темно-синий) -->
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <!-- Иконка в центре -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- Тема, на которую переключимся ПОСЛЕ заставки -->
        <item name="postSplashScreenTheme">@style/Theme.DnDHelper</item>
    </style>
</resources>
